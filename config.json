{
  "server": {
    "host": "127.0.0.1",
    "port": 8099,
    "threads": 2
  },

  "dataDir": "data",

  "modules": {
    "hub": true,
    "tiles": true
  },

  "ingest": {
    "enabled": true,
    "mergeWindowMs": 0,
    "note": "mergeWindowMs=0（接入层不合并同设备报文）：步 6 的链路丢包率按报文 seq 断号实测；合并窗会把同一设备的多条报文并成一条，断号率就变成接入层的合并率（实测 0.47）而不是链路丢包 —— 口径不符。>0 时 topology.evaluate 会在 notes 里点名",
    "points": [
      {
        "id": "ingest-uav",
        "group": "",
        "port": 45500,
        "iface": "",
        "parserId": "legacy.kind.v1",
        "deviceType": "uav",
        "topic": "telemetry.uav.pos",
        "enabled": true
      }
    ]
  },

  "ingestHost": "127.0.0.1",

  "simKind": "uav.pos",
  "simWireType": "uav",
  "simSpeed": 1,
  "simAutoStart": true,
  "simAutoStartNote": "true = 启动加载阶段就拉起数据链路。本工程的'链路/集群节点'探针要的是**真实报文与在线设备**，不起仿真源时它们只会停在 50%（启动加载永远完不成、进不了第 2 步）。因此'起飞'属启动阶段，步 6 的控制语义是**暂停/恢复/倍速**。",
  "scenarioDir": "data/scenario-1",

  "mediaRoot": "data/scenario-1/media",

  "tiles": {
    "template": "/tiles/{z}/{x}/{y}.jpg",
    "basePath": "/tiles",
    "missingStatus": 404,
    "packageId": "basemap",
    "version": "v1",
    "root": "../map-2d/tiles",
    "subDir": "raster"
  },

  "selfcheck": {
    "policies": "../selfcheck/policies/mapapp/probes.json",
    "capabilities": "../selfcheck/probes/mapapp/capabilities.json"
  },

  "webDist": "apps/web/dist"
}
